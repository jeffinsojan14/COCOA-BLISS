# Cocoa Bliss Backend Environment Configuration
SECRET_KEY=cocoa-bliss-super-secret-key-for-college-project-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database Configuration
# Set DB_ENGINE=mysql to use MySQL (make sure MySQL is running and database exists)
# Or keep DB_ENGINE=sqlite3 for zero-setup local execution
DB_ENGINE=sqlite3
DB_NAME=cocoa_bliss
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
