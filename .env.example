# ==========================================================
# Cocoa Bliss — Environment Configuration
# ==========================================================

# Backend Configuration (backend/.env)
SECRET_KEY=cocoa-bliss-super-secret-key-for-college-project-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Set DB_ENGINE=mysql to connect to MySQL (PyMySQL is preconfigured)
# Set DB_ENGINE=sqlite3 for zero-setup local demonstration
DB_ENGINE=sqlite3
DB_NAME=cocoa_bliss
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration (frontend/.env)
VITE_API_BASE_URL=http://127.0.0.1:8000
